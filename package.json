{
  "name": "infisheet",
  "version": "1.2.1",
  "private": true,
  "description": "本地 ComfyUI 的无限画布：把工作流拆成节点摆到画布上，连线、调参、运行、出图",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python server.py",
    "dev": "python server.py --port 8788 --no-browser",
    "check": "node tools/check.mjs",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint static tests tools",
    "lint:py": "ruff check .",
    "fix": "eslint static tests tools --fix && ruff check . --fix",
    "hooks": "git config core.hooksPath tools/hooks",
    "test": "python tests/smoke.py",
    "test:api": "python selftest.py",
    "test:images": "python tests/images.py",
    "test:mcp": "python tests/mcp.py",
    "test:e2e": "node tests/e2e/run.mjs",
    "shots": "node tests/e2e/walkthrough.mjs",
    "pack": "python tools/pack.py",
    "format": "prettier --write \"static/**/*.{js,css,html}\" \"tests/**/*.mjs\" \"tools/**/*.{mjs,cjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "3.3.3"
  }
}
