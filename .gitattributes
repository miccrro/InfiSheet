# 统一行尾：跨平台协作时别让 Windows 的 CRLF 混进源码
* text=auto eol=lf

# 源码 / 配置 / 文档：强制 LF
*.py     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析 goto/label 会出问题
*.bat    text eol=crlf

# 二进制：不做行尾转换，也不要参与 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.zip    binary
