# 运行时数据（每个人的画布/历史/工作流库都不该进版本库）
data/

# 资产库默认位置（生成结果按时间存进这里，属于用户数据）
assets/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# 测试与打包产物
tests/.tmp/
dist/

# 清理时的暂存区（移进来的文件先留着，确认没用再手动删）
.trash/

# Windows 快捷方式：里面存的是绝对路径，只对生成它的这台机器有效。
# 发给别人用 创建快捷方式.vbs（按自身位置算路径），不要提交 .lnk。
InfiSheet.lnk

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地工作记录（助手的过程笔记，成果已整理进验收报告）
.workbuddy/
.workbuddy-ai/
